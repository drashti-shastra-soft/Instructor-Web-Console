@model InstructorWebClient.Domain.StudentCourseLister

<div class="card mb-4">
    <div class="card-header" style="text-align:right">
        <a href="javascript:void(0)" class="btn btn-primary add-student-course">Add Student Course</a>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <table id="tbl-student" class="table table-bordered table-striped">
                    <tr>
                        <th>
                            Course Name
                        </th>
                        <th>
                            Start Date
                        </th>
                        <th>
                            End Date
                        </th>
                        <th>
                            Status
                        </th>
                        <th colspan="2" class="text-center">
                            Action
                        </th>
                    </tr>
                    <tr>
                        <td>
                            @Html.TextBoxFor(m => m.SearchCriteria.Course, new { @class = "form-control form-search-input" })
                        </td>
                        <td>
                            
                        </td>
                        <td>
                            
                        </td>
                        <td>
                            
                        </td>
                        <td colspan="2">
                            
                        </td>
                    </tr>
                    @if (Model != null && Model.List != null && Model.List.Count > default(int))
                    {
                        foreach (var item in Model.List)
                        {
                            <tr>

                                <td>@item.Course</td>
                                <td>@item.StartDate</td>
                                <td>@item.EndDate</td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">Disabled</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="javascript:void(0);" data-id="@item.Id" class="icon-edit edit-btn"><i class="fa-solid fa-pen-to-square"></i></a>
                                </td>
                                <td class="text-center">
                                    <a href="javascript:void(0);" data-id="@item.Id" class="icon-delete delete-btn text-danger"><i class="fa-solid fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center"> No record found!</td>
                        </tr>
                    }
                </table>
            </div>
        </div>
    </div>
</div>
<script src="@Url.Content("~/custom-js/student-course/list.js")"></script>