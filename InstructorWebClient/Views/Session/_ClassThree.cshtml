@model InstructorWebClient.Domain.Session

@Html.HiddenFor(m => m.Id)
@Html.HiddenFor(m => m.UserId)
@Html.HiddenFor(m => m.ClassType)
<!-- Date and Time Inputs -->
<div class="row mb-2">
    <div class="col">
        <label>Date <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
        <span class="text-danger date-error" style="display:none;"></span>
    </div>
</div>

<div class="row mb-2">
    <div class="col">
        <label>From Time <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.StartTime, "{0:HH:mm}", new { @class = "form-control", @type = "time" })
        <span class="text-danger time-error" style="display:none;"></span>
    </div>
    <div class="col">
        <label>To Time <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.EndTime, "{0:HH:mm}", new { @class = "form-control", @type = "time" })
        <span class="text-danger time-error" style="display:none;"></span>
    </div>
</div>

<!-- Student Names -->
<div class="row mb-2 module-entry">
    <div class="col">
        <label>Student Names (comma-separated) <span class="text-danger">*</span></label>
        @Html.DropDownList("Students", new SelectList(ViewBag.Students, "Value", "Text"), new { @class = "form-control js-multiple-limit", multiple = "multiple" })
        <span class="text-danger student-error"></span>
    </div>
</div>


<script>
    $(document).ready(function () {
        // Auto-fill current date/time for new session
        const now = new Date();
        const timeStr = now.toTimeString().slice(0, 5);
        const dateStr = now.toISOString().split('T')[0];
        const id = parseInt($('#Id').val());

        if (id <= 0) {
            $('#Date').val(dateStr);
            $('#StartTime').val(timeStr);
            $('#EndTime').val(timeStr);
        }
        
        $('#modal-session .js-multiple-limit').select2({
            dropdownParent: $('#modal-session'),
        });
    });

    $(document).off('click', '.btn-submit').on('click', '.btn-submit', function () {
        const startTime = $('#StartTime').val()?.trim();
        const endTime = $('#EndTime').val()?.trim();
        
        if (!fnValidation()) return;
        
        const payload = {
            Id: $('#Id').val(),
            UserId: $('#UserId').val(),
            Date: $('#Date').val(),
            StartTime: startTime,
            EndTime: endTime,           
            ClassType: $('#ClassType').val(),
            StudentSessions: CollectStudents()
        };
        debugger;
        var requestData = JSON.stringify(payload);
        
        $.ajax({
            url: '/Session/Create',
            type: 'POST',
            contentType: 'application/json',
            data: requestData,
            beforeSend: function () {
                $('#loading-element').show();
            },
            success: function (response) {
                if (response?.notificationType === 'success') {
                    fnGetNotified(response.notificationType, response.notificationMsg);
                    $('.modal').modal('hide');
                    $('body').removeClass('modal-open');
                    $('.modal-backdrop').remove();
                    $('#frmList').submit();
                } else {
                    fnGetNotified(response.notificationType, response.notificationMsg);
                }
            },
            error: function () {
                fnGetNotified('error', 'Error saving session. Please try again.');
            },
            complete: function () {
                $('#loading-element').hide();
            }
        });
    });

    function CollectStudents() {
        const students = [];
         debugger;
        var selectedValues = $("#Students").val();
        $.each(selectedValues, function (index, value) {
            debugger;
            var student = {
                StudentId: value,                
            };
            students.push(student);
        });

        return students;
    }

    // Main validation
    function fnValidation() {
        let isValid = true;

        const date = $("#Date").val()?.trim();
        const students = $("#Students").val();
        const startTimeStr = $("#StartTime").val()?.trim();
        const endTimeStr = $("#EndTime").val()?.trim();

        $("#Date").next('.date-error').text('').hide();
        $('#StartTime').next('.time-error').text('').hide();
        $('#EndTime').next('.time-error').text('').hide();
        $(".student-error").text('').hide();

        // 🔹 Validate Date
        if (!date) {
            $("#Date").next('.date-error').text("Date is required!").show();
            isValid = false;
        }

        // 🔹 Validate Start Time
        if (!startTimeStr) {
            $('#StartTime').next('.time-error').text('From Time is required!').show();
            isValid = false;
        }

        // 🔹 Validate End Time
        if (!endTimeStr) {
            $('#EndTime').next('.time-error').text('To Time is required!').show();
            isValid = false;
        }

        // 🔹 Student  Time
        if (students.length <= 0) {
            $('.student-error').text('Please select atleast one student!').show();
            isValid = false;
        }

        let sessionDuration = 0;

        // 🔹 Compare Start and End Time
        if (startTimeStr && endTimeStr) {
            const start = parseTimeToMinutes(startTimeStr);
            const end = parseTimeToMinutes(endTimeStr);

            if (isNaN(start) || isNaN(end)) {
                $('#EndTime').next('.time-error').text('Invalid time format.').show();
                isValid = false;
            } else if (end <= start) {
                $('#EndTime').next('.time-error').text('End Time must be greater than Start Time.').show();
                isValid = false;
            } else {
                sessionDuration = end - start;
            }
        }

        return isValid;
    }
</script>